# ==============================================================================
# Copy this file to .env and fill in actual values.
# Secrets only. Monitored bridges live in evm-ingester/evm-bridges.toml and
# solana-ingester/solana-bridges.toml.
# ==============================================================================

# EVM RPC URL with API key (e.g., Alchemy, Infura)
# Mainnet example: wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
ETH_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Solana RPC URL — must be a WebSocket URL (wss://); the ingester derives the HTTP URL from it
# Public endpoint: wss://api.mainnet-beta.solana.com (rate-limited; paid service recommended for production)
SOLANA_RPC_URL=wss://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
