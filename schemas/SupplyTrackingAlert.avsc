{
  "type": "record",
  "name": "SupplyTrackingAlert",
  "namespace": "com.web3analytics.alerts",
  "doc": "Supply tracking alert from 5-minute tumbling window. Monitors wrapped token mint/burn operations.",
  "fields": [
    {"name": "bridgeAddress", "type": "string"},
    {"name": "chain", "type": "string", "doc": "CAIP-2 format: eip155:1 or solana:5eykt..."},
    {"name": "protocol", "type": {"type": "enum", "name": "BridgeProtocol", "symbols": ["wormhole", "layerzero", "hop", "allbridge"]}},
    {"name": "windowStart", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "windowEnd", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "severity", "type": {"type": "enum", "name": "Severity", "symbols": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}},
    {"name": "alertType", "type": "string", "default": "SUPPLY_TRACKING"},
    {"name": "mintCount", "type": "int"},
    {"name": "burnCount", "type": "int"},
    {"name": "totalMinted", "type": {"type": "bytes", "logicalType": "decimal", "precision": 78, "scale": 0}},
    {"name": "totalBurned", "type": {"type": "bytes", "logicalType": "decimal", "precision": 78, "scale": 0}},
    {"name": "netMinted", "type": {"type": "bytes", "logicalType": "decimal", "precision": 78, "scale": 0}},
    {"name": "tokenSymbol", "type": ["null", "string"], "default": null, "doc": "TriState merge result - may be null if enrichment not implemented"}
  ]
}
