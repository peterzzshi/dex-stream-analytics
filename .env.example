# ==============================================================================
# SECRETS - Copy this file to .env and fill in actual values
# ==============================================================================

# EVM RPC URL with API key (e.g., Alchemy, Infura)
# Mainnet example: https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Solana RPC URL (can use public endpoint or paid service like Helius, Triton)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com


# ==============================================================================
# EVM INGESTER CONFIGURATION
# ==============================================================================

# Chain identifier in CAIP-2 format (namespace:reference)
# Examples: eip155:1 (Ethereum mainnet), eip155:137 (Polygon), eip155:42161 (Arbitrum)
EVM_CHAIN_ID=eip155:1

# Human-readable chain name
EVM_CHAIN_NAME=ethereum

# DEX venue identifier
EVM_CHAIN_VENUE=uniswap-v2

# Number of block confirmations before processing events
EVM_CHAIN_CONFIRMATIONS=12

# Pool contract address to monitor
EVM_POOL_ADDRESS=0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc

# Human-readable pool name
EVM_POOL_NAME=USDC/WETH


# ==============================================================================
# SOLANA INGESTER CONFIGURATION
# ==============================================================================

# Solana commitment level: processed, confirmed, or finalized
SOLANA_COMMITMENT=finalized

# Pool address to monitor (base58 encoded)
# Example: Orca USDC/SOL pool
SOLANA_POOL_ADDRESS=7qbRF6YsyGuLUVs6Y1q64bdVrfe4ZcUUz1JRdoVNUJnm

# Pool name for identification
SOLANA_POOL_NAME=SOL/USDC

# Token mint addresses (base58 encoded)
# SOL wrapped token mint
SOLANA_POOL_TOKEN0=So11111111111111111111111111111111111111112

# USDC mint address on Solana
SOLANA_POOL_TOKEN1=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
