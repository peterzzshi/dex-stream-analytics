# ============================================================================
# Event Ingester - Environment Variables
# ============================================================================
# Only needed for live chain data:
#   docker compose --profile live up -d
#
# The default `docker compose up -d` runs the full analytics pipeline
# (Kafka -> Flink -> analytics-service) without these; feed it with
# scripts/produce_test_events.py instead.
#
# Chains, pools, topics, and finality depth are NOT environment variables —
# they live in evm-ingester/config/evm-ingester.yaml, which is versioned and
# mounted into the container. Only secrets belong here.
# ============================================================================

# REQUIRED (live profile): EVM RPC WebSocket endpoint
# ⚠️  MUST use WebSocket (wss://) not HTTP (https://)
#
# Get free API key from:
#   • Alchemy: https://www.alchemy.com/ (recommended)
#     Format: wss://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY
#   • Infura: https://www.infura.io/
#     Format: wss://mainnet.infura.io/ws/v3/YOUR-PROJECT-ID
#
# Referenced as ${ETH_RPC_URL} by evm-ingester/config/evm-ingester.yaml.
ETH_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY
