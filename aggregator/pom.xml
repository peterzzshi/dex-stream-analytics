<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.web3analytics</groupId>
    <artifactId>aggregator</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Web3 DEX Analytics - Flink Aggregator</name>

  <build>
    <plugins>
      <!-- Maven Compiler -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.13.0</version>
      </plugin>

      <!-- Avro code generation -->
      <plugin>
        <artifactId>avro-maven-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <sourceDirectory>${project.basedir}/src/main/resources/avro</sourceDirectory>
              <stringType>String</stringType>
            </configuration>
            <goals>
              <goal>schema</goal>
            </goals>
            <id>generate-avro-classes</id>
            <phase>generate-sources</phase>
          </execution>
        </executions>
        <groupId>org.apache.avro</groupId>
        <version>${avro.version}</version>
      </plugin>

      <!-- Shade Plugin for Fat JAR -->
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <artifactSet>
                <excludes>
                  <exclude>org.apache.flink:flink-streaming-java</exclude>
                  <exclude>org.apache.flink:flink-clients</exclude>
                  <exclude>org.apache.flink:flink-runtime</exclude>
                  <exclude>org.apache.flink:flink-core</exclude>
                  <exclude>org.apache.flink:flink-core-api</exclude>
                  <exclude>org.apache.flink:flink-datastream-api</exclude>
                  <exclude>org.apache.flink:flink-datastream</exclude>
                  <exclude>org.apache.flink:flink-metrics-core</exclude>
                  <exclude>org.apache.flink:flink-annotations</exclude>
                  <exclude>org.apache.flink:flink-rpc-core</exclude>
                  <exclude>org.apache.flink:flink-rpc-akka-loader</exclude>
                  <exclude>org.apache.flink:flink-queryable-state-client-java</exclude>
                  <exclude>org.apache.flink:flink-hadoop-fs</exclude>
                  <exclude>org.apache.flink:flink-file-sink-common</exclude>
                  <exclude>org.apache.flink:flink-connector-datagen</exclude>
                  <exclude>org.apache.flink:flink-connector-base</exclude>
                  <exclude>org.apache.flink:flink-shaded-force-shading</exclude>
                  <exclude>com.google.code.findbugs:jsr305</exclude>
                  <exclude>org.slf4j:*</exclude>
                  <exclude>org.apache.logging.log4j:*</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.web3analytics.StreamProcessor</mainClass>
                </transformer>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.6.2</version>
      </plugin>

      <!-- Surefire for Tests -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <artifactId>dependency-check-maven</artifactId>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.owasp</groupId>
        <version>11.1.1</version>
      </plugin>

    </plugins>

  </build>

  <dependencies>
        <!-- Flink Core (provided by the Flink dist at runtime — must not be
             bundled, or user-jar copies of Flink classes shadow the cluster's
             and Java-serialized lambdas fail with ClassCastException) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flink Kafka Connector (native, avoids DAPR) — not in the dist, stays bundled -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
          <version>5.0.0-2.2</version>
        </dependency>

        <!-- Flink Avro (unused at runtime — provided for compilation only) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-avro</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Avro -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>

        <!-- Kafka clients -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    <dependency>
      <artifactId>jackson-core</artifactId>
      <groupId>com.fasterxml.jackson.core</groupId>
    </dependency>

    <!-- CloudEvents SDK -->
    <dependency>
      <artifactId>cloudevents-core</artifactId>
      <groupId>io.cloudevents</groupId>
      <version>4.0.1</version>
    </dependency>
    <dependency>
      <artifactId>cloudevents-json-jackson</artifactId>
      <groupId>io.cloudevents</groupId>
      <version>4.0.1</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
          <exclusions>
            <!-- Exclude ZooKeeper test utilities - not needed for our tests
                 curator-test pulls in zookeeper:3.9.6 with CVE-2023-44981, CVE-2024-23944
                 We don't use ZK in tests, so exclude the entire curator-test tree -->
            <exclusion>
              <artifactId>curator-test</artifactId>
              <groupId>org.apache.curator</groupId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- Security: Override vulnerable transitive dependencies
           Using dependencyManagement forces these versions across the entire
           dependency tree, including transitive deps from Flink and Kafka -->

      <!-- Jackson: Core JSON processing (transitive from flink-connector-kafka)
           Fixes: CVE-2026-89407, CVE-2026-89425, CVE-2026-68498,
                  CVE-2026-18401, CVE-2026-68494, WS-2026-0003
           All are DoS/OOB read vulnerabilities in async parser -->
      <dependency>
        <artifactId>jackson-core</artifactId>
        <groupId>com.fasterxml.jackson.core</groupId>
        <version>2.22.3</version>
      </dependency>
      <dependency>
        <artifactId>jackson-databind</artifactId>
        <groupId>com.fasterxml.jackson.core</groupId>
        <version>2.22.3</version>
      </dependency>
      <dependency>
        <artifactId>jackson-annotations</artifactId>
        <groupId>com.fasterxml.jackson.core</groupId>
        <version>2.22</version>
      </dependency>

      <!-- Kafka compression codecs (transitive from kafka-clients)
           Required for Kafka producer/consumer; cannot exclude -->

      <!-- snappy-java: Fixes CVE-2026-90559 (OOB write in uncompress) -->
      <dependency>
        <artifactId>snappy-java</artifactId>
        <groupId>org.xerial.snappy</groupId>
        <version>1.1.10.9</version>
      </dependency>

      <!-- zstd-jni: Fixes CVE-2026-87795, CVE-2026-87823, CVE-2026-89046,
                    CVE-2026-90560, CVE-2026-87825, CVE-2026-87877,
                    CVE-2026-87824, CVE-2026-90852, CVE-2026-89045
           All are OOB reads, use-after-free, and invalid input handling -->
      <dependency>
        <artifactId>zstd-jni</artifactId>
        <groupId>com.github.luben</groupId>
        <version>1.5.7-14</version>
      </dependency>

      <!-- lz4-java: Fixes CVE-2026-106451, CVE-2026-59949, CVE-2026-106453,
                     CVE-2026-106452, CVE-2026-106450, CVE-2026-106449
           Race condition in native lib loading, XXHash JNI validation,
           untrusted header sizes causing heap exhaustion, SOE on empty blocks -->
      <dependency>
        <artifactId>lz4-java</artifactId>
        <groupId>at.yawk.lz4</groupId>
        <version>1.11.4</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
        <!-- Development profile: Includes Flink runtime for IntelliJ/standalone -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-clients</artifactId>
                    <version>${flink.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.flink</groupId>
                    <artifactId>flink-connector-base</artifactId>
                    <version>${flink.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <!-- Production profile: Flink runtime provided by cluster -->
        <profile>
            <id>prod</id>
            <dependencies>
                <!-- All Flink dependencies remain 'provided' -->
            </dependencies>
        </profile>
    </profiles>

  <properties>
    <assertj.version>3.27.7</assertj.version>
    <avro.version>1.12.1</avro.version>
    <flink.version>2.3.0</flink.version>
    <java.version>21</java.version>
    <junit.version>5.11.4</junit.version>

    <kafka.version>4.2.0</kafka.version>
    <log4j.version>2.26.1</log4j.version>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <scala.binary.version>2.12</scala.binary.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>
</project>
